# =========================================================================
# Research Vault - Environment Variables
# =========================================================================
# This file is a TEMPLATE. Copy to `.env` and fill in real values.
# NEVER commit a real `.env` file. `.env` is in .gitignore.
#
# Phase 2 (NestJS Backend): only PORT is read at runtime right now.
# Everything else documents future phases and is not used yet.
# =========================================================================

# --- Backend (apps/api) ---------------------------------------------------
PORT=4000
# API is bound on localhost:4000. Web dev server is on :3000.

# --- Database (Phase 3, NOT YET WIRED) ------------------------------------
# Supabase Postgres direct connection (session pooler)
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Prisma shadow database (migrations)
# SHADOW_DATABASE_URL=""

# --- Supabase (Phase 3+, NOT YET WIRED) -----------------------------------
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""       # server-only, never expose to browser
# SUPABASE_JWT_SECRET=""             # for token verification

# --- Storage (Phase 4+, NOT YET WIRED) ------------------------------------
# SUPABASE_STORAGE_BUCKET="research-vault-dev"
# SUPABASE_STORAGE_REGION=""

# --- Auth (Phase 3, NOT YET WIRED) ----------------------------------------
# JWT_SECRET=""
# JWT_EXPIRES_IN="15m"
# REFRESH_TOKEN_EXPIRES_IN="7d"

# --- Frontend (apps/web) - Phase 3+, NOT YET WIRED ------------------------
# NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Feature flags --------------------------------------------------------
NODE_ENV=development